# Public web config for the live build (Netlify reads this at build time).
# Only VITE_* values that end up in the browser bundle anyway; access is limited by the Firebase
# authorized domains and firestore.rules. Secrets (GEMINI_API_KEY) stay in Netlify env vars only.
VITE_FIREBASE_API_KEY=AIzaSyASqsXX5hs8CfQBL4UIqvV0PEEZKZjFFzk
VITE_FIREBASE_AUTH_DOMAIN=inline-binus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=inline-binus
VITE_FIREBASE_APP_ID=1:390029743404:web:672e8af279f577b809c889

# Microsoft campus login hidden until the Entra app is set up.
VITE_MICROSOFT_TENANT=binus.ac.id
VITE_MICROSOFT_LOGIN=off
