# Copy to .env.local for local development, and add the same names in
# Netlify → Site configuration → Environment variables for the live site.

# Firebase Authentication (Google + email/password). From Firebase console →
# Project settings → Your apps → Web app config. These are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Microsoft (akun kampus) login. Tenant of the BINUS Microsoft 365 directory (domain or tenant ID).
# Set VITE_MICROSOFT_LOGIN=off to hide the Microsoft buttons (e.g. if BINUS requires admin consent).
VITE_MICROSOFT_TENANT=binus.ac.id
# VITE_MICROSOFT_LOGIN=off

# AI search (Netlify Function only — never prefix with VITE_, it must not reach the browser).
# Free key from aistudio.google.com (free tier: Google may use these prompts to improve its products).
GEMINI_API_KEY=
# Optional: Gemini model for the AI search (default gemini-3.5-flash-lite).
# INLINE_AI_MODEL=
