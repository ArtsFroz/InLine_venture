rules_version = '2';

// InLine Firestore rules. Paste into Firebase console → Firestore → Rules (or `firebase deploy --only firestore:rules`).
// - buddyApplications/{uid}: one buddy application per account. The applicant submits it as "pending";
//   only an admin can approve or reject it, and the KTM/selfie photos must be wiped in that same write.
// - admins/{uid}: created by hand in the console. Nobody can write it from the app.
// - placeSuggestions/{uid}_{n}: places suggested by students, shown to everyone once an admin approves them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Email/password accounts must have clicked the verification link; Google/Microsoft emails are verified by the provider.
    function emailVerified() {
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider in ['google.com', 'microsoft.com'];
    }

    function microsoftLinked() {
      return 'microsoft.com' in request.auth.token.firebase.identities;
    }

    // Size cap + JPEG data-URL prefix (split instead of a regex over the whole ~380k-character string).
    function validImage(v) {
      return v is string && v.size() > 1000 && v.size() < 400000
        && v.split(',').size() == 2 && v.split(',')[0] == 'data:image/jpeg;base64';
    }

    function validApplication(d, uid) {
      return d.keys().hasOnly(['uid', 'name', 'email', 'nim', 'campus', 'whatsapp', 'binusEmail', 'microsoftLinked',
                               'ktmImage', 'selfieImage', 'consent', 'status', 'note', 'submittedAt', 'reviewedAt', 'reviewedBy'])
        && d.keys().hasAll(['uid', 'name', 'email', 'nim', 'campus', 'whatsapp', 'binusEmail', 'microsoftLinked',
                            'ktmImage', 'selfieImage', 'consent', 'status', 'note', 'submittedAt', 'reviewedAt', 'reviewedBy'])
        && d.uid == uid
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.email is string && d.email.size() <= 120
        && d.nim is string && d.nim.matches('^[0-9]{10}$')
        && d.campus in ['Anggrek', 'Syahdan', 'Kijang', 'Binus Square']
        && d.whatsapp is string && d.whatsapp.matches('^628[0-9]{7,11}$')
        && d.microsoftLinked == microsoftLinked()
        && (d.binusEmail == null || (d.microsoftLinked == true && d.binusEmail is string
                                     && d.binusEmail.matches('^[^@ ]+@binus[.]ac[.]id$')))
        && validImage(d.ktmImage) && validImage(d.selfieImage)
        && d.consent == true
        && d.status == 'pending'
        && d.note == null && d.reviewedAt == null && d.reviewedBy == null
        && d.submittedAt == request.time;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /buddyApplications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid && emailVerified()
        && validApplication(request.resource.data, uid);

      // Resubmitting after a rejection.
      allow update: if signedIn() && request.auth.uid == uid && emailVerified()
        && resource.data.status == 'rejected'
        && validApplication(request.resource.data, uid);

      // Review: only the decision fields change, the photos are removed, and the reviewer is recorded.
      allow update: if isAdmin()
        && request.auth.uid != uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'note', 'reviewedAt', 'reviewedBy', 'ktmImage', 'selfieImage'])
        && request.resource.data.status in ['verified', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.ktmImage == null
        && request.resource.data.selfieImage == null
        && (request.resource.data.note == null
            || (request.resource.data.note is string && request.resource.data.note.size() <= 200));

      // The applicant can withdraw while not yet verified; an admin can remove any application (e.g. revoke a buddy).
      allow delete: if (signedIn() && request.auth.uid == uid && resource.data.status != 'verified') || isAdmin();
    }

    // ——— Places suggested by students ———
    // placeSuggestions/{uid}_{1..5}: at most 5 suggestions per account (the id is the cap, no server needed).
    // Pending ones are seen only by the author and admins; approved ones by every signed-in user.

    function validMenuItem(m) {
      return m is map && m.keys().hasOnly(['name', 'price']) && m.keys().hasAll(['name', 'price'])
        && m.name is string && m.name.size() >= 2 && m.name.size() <= 40
        && m.price is int && m.price >= 1000 && m.price <= 500000;
    }

    function validSuggestion(d, uid) {
      return d.keys().hasOnly(['uid', 'name', 'category', 'campus', 'area', 'distanceM', 'locationNote', 'openHours',
                               'menu', 'status', 'note', 'submittedAt', 'reviewedAt', 'reviewedBy'])
        && d.keys().hasAll(['uid', 'name', 'category', 'campus', 'area', 'distanceM', 'locationNote', 'openHours',
                            'menu', 'status', 'note', 'submittedAt', 'reviewedAt', 'reviewedBy'])
        && d.uid == uid
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.category in ['Kopi', 'Kantin', 'Minuman', 'Snack']
        && d.campus in ['Anggrek', 'Syahdan', 'Kijang', 'Binus Square']
        && d.area in ['Basement', 'Outdoor', 'Lantai 1', 'Lantai 5', 'Kampus', 'Sekitar kampus']
        && (d.campus == 'Anggrek' || d.area in ['Kampus', 'Sekitar kampus'])
        && d.distanceM is int && d.distanceM >= 0 && d.distanceM <= 3000
        && d.locationNote is string && d.locationNote.size() <= 120
        && d.openHours is string && d.openHours.matches('^([01][0-9]|2[0-3])[.][0-5][0-9]–([01][0-9]|2[0-3])[.][0-5][0-9]$')
        && d.menu is list && d.menu.size() >= 1 && d.menu.size() <= 3
        && validMenuItem(d.menu[0])
        && (d.menu.size() < 2 || validMenuItem(d.menu[1]))
        && (d.menu.size() < 3 || validMenuItem(d.menu[2]))
        && d.status == 'pending'
        && d.note == null && d.reviewedAt == null && d.reviewedBy == null
        && d.submittedAt == request.time;
    }

    match /placeSuggestions/{id} {
      allow read: if signedIn()
        && (resource.data.status == 'approved' || resource.data.uid == request.auth.uid || isAdmin());

      allow create: if signedIn() && emailVerified()
        && id in [request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3',
                  request.auth.uid + '_4', request.auth.uid + '_5']
        && validSuggestion(request.resource.data, request.auth.uid);

      // Review: only the decision fields change, and the reviewer is recorded.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.note == null
            || (request.resource.data.note is string && request.resource.data.note.size() <= 200));

      // The author can withdraw while not yet approved (frees the slot); an admin can remove any place.
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid && resource.data.status != 'approved') || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
